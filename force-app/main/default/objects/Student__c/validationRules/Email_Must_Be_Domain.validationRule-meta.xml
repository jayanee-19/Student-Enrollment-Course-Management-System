<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Email_Must_Be_Domain</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(CONTAINS(e_mail__c, &quot;@student.edu&quot;))</errorConditionFormula>
    <errorDisplayField>e_mail__c</errorDisplayField>
    <errorMessage>Email must be a valid student institutional email.</errorMessage>
</ValidationRule>
