<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>Creates a follow-up Task for an Admin when an Enrollment is Requested.</description>
    <environments>Default</environments>
    <formulas>
        <name>Followup_Due_Date</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 2</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Create Follow-up Task {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create Follow-up Task</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Followup_Task</name>
        <label>Create Follow-up Task</label>
        <locationX>314</locationX>
        <locationY>158</locationY>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Follow up on enrollment request.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>Get_Admin_User.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>Followup_Due_Date</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Admin_User</name>
        <label>Get Admin User</label>
        <locationX>182</locationX>
        <locationY>158</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Profile.Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>System Administrator</stringValue>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <connector>
            <targetReference>Get_Admin_User</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Enrollment_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Requested</stringValue>
            </value>
        </filters>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <object>Enrollment__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
